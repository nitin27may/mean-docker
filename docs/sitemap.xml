---
permalink: /sitemap.xml
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{% comment %}
  Hand-rolled rather than generated by jekyll-sitemap so that:
    - `lastmod` reflects the page's own `last_modified_at`, not the CI checkout mtime
      (jekyll-sitemap falls back to file mtime, which is the build time for every page
      on a fresh runner, making lastmod worthless as a change signal);
    - redirect stubs and any page carrying `sitemap: false` stay out.
  Absolute URLs come from site.url + site.baseurl via `absolute_url`, so this file is
  submittable as-is under the https://nitinksingh.com/ Search Console property.
{% endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | sort: "url" -%}
{%- for p in pages -%}
{%- if p.sitemap == false or p.noindex == true -%}{%- continue -%}{%- endif -%}
{%- if p.url contains "404" -%}{%- continue -%}{%- endif %}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
{%- if p.last_modified_at %}
    <lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>
{%- endif %}
    <changefreq>{{ p.changefreq | default: "monthly" }}</changefreq>
    <priority>{{ p.priority | default: "0.6" }}</priority>
  </url>
{%- endfor %}
</urlset>
