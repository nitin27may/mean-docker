# Prefix for the container names created by docker compose.
# Applies to every compose file (dev, nginx, hub).
ID_PROJECT=mean

# API Configuration
# PORT is what the Express process listens on inside its container.
PORT=3000
# EXPRESS_PORT is the host port the dev compose file publishes the API on.
EXPRESS_PORT=3000
NODE_ENV=development

# JWT signing key. The API refuses to start while this is unset, still set to
# the placeholder below, or shorter than 32 characters. Generate one with:
#   openssl rand -base64 48
SECRET=your-jwt-secret-key

# Comma-separated list of browser origins allowed to call the API.
# Leave empty for the nginx mode, where everything is same-origin.
CORS_ORIGINS=

# MongoDB Configuration
MONGO_DB_USERNAME=dbuser
MONGO_DB_PASSWORD=password123
MONGO_DB_HOST=database
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=contact_db
MONGO_DB_PARAMETERS=?authSource=admin
MONGO_INITDB_ROOT_USERNAME=dbuser
MONGO_INITDB_ROOT_PASSWORD=password123
