{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1"],
      "env": {}
    },
    "mongodb": {
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server@2"],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "mongodb://${MONGO_DB_USERNAME}:${MONGO_DB_PASSWORD}@localhost:${MONGO_DB_PORT}/${MONGO_DB_DATABASE}${MONGO_DB_PARAMETERS}"
      }
    }
  }
}
